<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ningk.immich-safe-start</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_WITH_MAC_USERNAME/immich-app/immich-safe-start.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/REPLACE_WITH_MAC_USERNAME/.docker/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/REPLACE_WITH_MAC_USERNAME</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/REPLACE_WITH_MAC_USERNAME/Library/Logs/Immich/safe-start.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_WITH_MAC_USERNAME/Library/Logs/Immich/safe-start-error.log</string>
</dict>
</plist>
