# Copy to .env and replace the username/path and password placeholders locally.
# This file contains no production credentials. Never commit .env.
IMMICH_VERSION=v3.3.5

# Existing external APFS volumes; update UUIDs only after confirming disk identity.
IMMICH_MEDIA_VOLUME=/Volumes/ImmichMedia
IMMICH_MEDIA_UUID=7F6F9F56-0CE5-4815-98DA-F673E2E6909C
IMMICH_MEDIA_SENTINEL=/Users/REPLACE_WITH_MAC_USERNAME/immich-data/guard/immich-volume-sentinel
IMMICH_MEDIA_SENTINEL_CONTENT=IMMICH_MEDIA_SEAGATE_OK

IMMICH_BACKUP_VOLUME=/Volumes/EnvoySSD
IMMICH_BACKUP_UUID=5718FC81-D5A6-4909-8B42-0CD7F81DB50D
IMMICH_BACKUP_SENTINEL=/Volumes/EnvoySSD/.immich-backup-volume-sentinel
IMMICH_BACKUP_SENTINEL_CONTENT=IMMICH_ENVOY_BACKUPS_OK

# Host paths
UPLOAD_LOCATION=/Volumes/ImmichMedia/nas/public/immich
EXTERNAL_LOCATION=/Volumes/ImmichMedia/nas/public/archive
BACKUP_LOCATION=/Volumes/EnvoySSD/ImmichBackups
DB_DATA_LOCATION=/Users/REPLACE_WITH_MAC_USERNAME/immich-data/postgres
IMMICH_CACHE_LOCATION=/Users/REPLACE_WITH_MAC_USERNAME/immich-data/cache
IMMICH_CONFIG_LOCATION=/Users/REPLACE_WITH_MAC_USERNAME/immich-data/config
IMMICH_APP_HOME=/Users/REPLACE_WITH_MAC_USERNAME/immich-app

# Database account. Generate a new secret and store it outside this repository.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_SECRET
